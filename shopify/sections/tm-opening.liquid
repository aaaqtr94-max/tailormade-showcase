{%- comment -%}
  TAILORMADE opening: the word types itself, the 3D TM monogram (black gloss face, gold sides)
  fades in and out over the leather-and-suede film. Upload the two films in Settings > Files
  (or pick them in the section settings) — nothing here depends on GitHub Pages.
{%- endcomment -%}
{%- liquid
  assign word = section.settings.word | default: 'TAILORMADE'
  assign tag = section.settings.heading_tag | default: 'h2'

  assign wide_src = section.settings.video_wide_url
  assign wide_poster = ''
  if section.settings.video_wide != blank
    assign best = 0
    for s in section.settings.video_wide.sources
      if s.format == 'mp4' and s.height <= 1080 and s.height > best
        assign best = s.height
        assign wide_src = s.url
      endif
    endfor
    assign wide_poster = section.settings.video_wide.preview_image | image_url: width: 1920
  endif

  assign tall_src = section.settings.video_tall_url
  assign tall_poster = ''
  if section.settings.video_tall != blank
    assign best = 0
    for s in section.settings.video_tall.sources
      if s.format == 'mp4' and s.height <= 1920 and s.height > best
        assign best = s.height
        assign tall_src = s.url
      endif
    endfor
    assign tall_poster = section.settings.video_tall.preview_image | image_url: width: 1080
  endif
  if tall_src == blank
    assign tall_src = wide_src
    assign tall_poster = wide_poster
  endif

  assign nx_wide = section.settings.stitch_wide | divided_by: 100.0
  assign nx_tall = section.settings.stitch_tall | divided_by: 100.0
  assign shade = section.settings.shade | divided_by: 100.0
  assign chars = word | split: ''
-%}

<section
  class="tmo"
  id="tmo-{{ section.id }}"
  data-tmo
  data-wide="{{ wide_src }}"
  data-tall="{{ tall_src }}"
  data-wide-poster="{{ wide_poster }}"
  data-tall-poster="{{ tall_poster }}"
  data-nx-wide="{{ nx_wide }}"
  data-nx-tall="{{ nx_tall }}"
  data-logo="{{ section.settings.show_logo }}"
  aria-label="{{ word | escape }}"
  style="--tmo-h: {{ section.settings.height }}svh; --tmo-shade: {{ shade }}; --tmo-bg: {{ section.settings.background }};"
>
  <div class="tmo-media" aria-hidden="true">
    <video class="tmo-film" muted autoplay playsinline loop preload="auto" disablepictureinpicture disableremoteplayback tabindex="-1"></video>
    <div class="tmo-shade"></div>
    <div class="tmo-veil" style="--tmo-veil: {{ section.settings.veil | divided_by: 100.0 }}"></div>
  </div>
  <canvas class="tmo-canvas" aria-hidden="true"></canvas>
  <{{ tag }} class="tmo-word" aria-label="{{ word | escape }}">
    {%- for c in chars -%}<span aria-hidden="true" style="--i: {{ forloop.index0 }}">{{ c | escape }}</span>{%- endfor -%}
    <i class="tmo-caret" aria-hidden="true"></i>
  </{{ tag }}>
  <div class="tmo-slot" aria-hidden="true"></div>
  {%- if section.settings.show_cue -%}
    <button type="button" class="tmo-cue" aria-label="Scroll to the products"><span>Scroll</span><i></i></button>
  {%- endif -%}
</section>

<style>
  .tmo{position:relative;isolation:isolate;height:100vh;height:var(--tmo-h,100svh);min-height:520px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(18px,4vh,40px);text-align:center;overflow:hidden;background:var(--tmo-bg,#2b2523);color:#fff}
  /* the film is fixed to the screen (like the original site) and clipped to this section;
     the product grid shows the same film under a white wash, so it reads as one film behind the page */
  .tmo-media{position:absolute;inset:0;z-index:-1;clip-path:inset(0)}
  .tmo-film,.tmo-shade,.tmo-veil{position:fixed;top:0;left:0;width:100%;height:100vh;height:100lvh;pointer-events:none}
  .tmo-film{object-fit:cover}
  .tmo-veil{background:#fff;opacity:0}
  .tmo-shade{background:linear-gradient(180deg,rgba(0,0,0,calc(var(--tmo-shade) * 1.05)) 0%,rgba(0,0,0,calc(var(--tmo-shade) * .3)) 45%,rgba(0,0,0,calc(var(--tmo-shade) * .95)) 100%)}
  .tmo-canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
  .tmo-word{position:relative;z-index:1;display:flex;margin:0 -.42em 0 0;font-family:'Instrument Sans',var(--font-body--family,system-ui),sans-serif;font-weight:500;font-size:clamp(22px,5.4vw,68px);letter-spacing:.42em;line-height:1;color:#fff;text-transform:none;
    text-shadow:0 0 1px rgba(0,0,0,.9),0 1px 3px rgba(0,0,0,.75),0 0 18px rgba(0,0,0,.55)}
  .tmo-word span{display:inline-block;opacity:0;transform:translateY(.35em);filter:blur(8px);transition:opacity .5s cubic-bezier(.2,.7,.2,1),transform .5s cubic-bezier(.2,.7,.2,1),filter .5s ease;transition-delay:calc(.3s + var(--i) * .11s)}
  .tmo.typed .tmo-word span{opacity:1;transform:none;filter:none}
  .tmo-caret{display:inline-block;width:2px;height:.95em;background:#fff;margin-left:.18em;align-self:center;animation:tmo-blink .9s steps(1) infinite;transition:opacity .3s}
  .tmo-caret.gone{opacity:0}
  @keyframes tmo-blink{50%{opacity:0}}
  .tmo-slot{position:relative;z-index:1;width:min(58vw,330px);aspect-ratio:1180/980}
  .tmo-cue{position:absolute;left:50%;bottom:24px;z-index:1;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;padding:6px 12px;background:none;border:0;cursor:pointer;font:inherit;font-size:10px;letter-spacing:.32em;text-transform:uppercase;color:rgba(255,255,255,.85);opacity:0;transition:opacity .8s}
  .tmo-cue.on{opacity:1}
  .tmo-cue i{width:1px;height:42px;background:linear-gradient(#fff,transparent);animation:tmo-cue 2s ease-in-out infinite;transform-origin:top}
  @keyframes tmo-cue{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(1);opacity:0}}
  @media (prefers-reduced-motion:reduce){
    .tmo-word span{opacity:1;transform:none;filter:none;transition:none}
    .tmo-caret{display:none}
    .tmo-cue i{animation:none}
  }
</style>

<script type="module">
if (!window.TMOpening) {
  const THREE_URL = 'https://cdn.jsdelivr.net/npm/three@0.169.0/+esm';
  const ROOM_URL = 'https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/environments/RoomEnvironment.js/+esm';
  const SVG_URL = 'https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/loaders/SVGLoader.js/+esm';
  const TM = 'M 616.2 618.2 C 614.6 619.8 614.5 705.5 616 706.5 C 616.6 706.9 618.7 705.9 620.6 704.3 C 622.6 702.8 624.9 701 625.9 700.5 C 626.8 699.9 628.6 698.7 630 697.9 C 643.9 688.9 648.9 685.9 660.3 679.6 C 682.2 667.7 719 652.9 744 646 C 746.5 645.3 750.5 644.2 753 643.5 C 761.9 641.1 772.7 638.9 783.8 637.5 C 798 635.6 838 635.4 839.8 637.2 C 840.7 638.1 841 708.1 841 946 C 841 1183.9 841.3 1253.9 842.2 1254.8 C 843.1 1255.7 854.6 1256 887.6 1256 L 931.8 1256 932.4 1253.8 C 932.7 1252.5 933 1177.8 933 1087.7 L 933 923.9 935.6 918.8 C 943.9 902.5 961 876.5 977.1 856 C 996.8 830.8 1022.7 806.3 1047 789.9 C 1077.4 769.3 1099.6 760.8 1134 756.6 C 1138.4 756 1148.9 757 1158 758.9 C 1174.1 762.2 1189.7 772.6 1201.5 788 C 1211.8 801.3 1219.4 823.8 1221.9 847.5 C 1222.7 855.5 1223 944.2 1223 1168.1 C 1223 1407.5 1223.3 1477.9 1224.2 1478.8 C 1225.5 1480.1 1308.2 1480.6 1311.4 1479.4 C 1312.9 1478.8 1313 1452.9 1313 1195.1 L 1313 911.4 1316.4 904.4 C 1337.4 860.6 1381.1 812.2 1424 785.4 C 1468.1 757.8 1509.6 749.5 1544.5 761.2 C 1566 768.4 1583.6 787.6 1590.5 811.5 C 1595.1 827.5 1595 819.1 1595 1158 C 1595 1405.2 1595.3 1477.9 1596.2 1478.8 C 1597.9 1480.5 1682.1 1480.5 1683.8 1478.8 C 1685.4 1477.2 1685.5 857.7 1684 840 C 1682.5 824 1679.5 810 1675.4 800.2 C 1674.6 798.4 1674 796.3 1674 795.6 C 1674 794.4 1671.8 790 1666.1 779.5 C 1659.9 768.1 1647.6 753.7 1637 745.6 C 1616.6 729.7 1604.1 723.8 1580.6 718.8 C 1567 716 1534.5 715.7 1520 718.4 C 1511.8 719.9 1506.8 721.1 1488.5 726 C 1475.4 729.5 1440.6 747.2 1418.4 761.6 C 1383.7 784.2 1347.4 821.6 1322.6 860.3 C 1318.8 866.2 1315.1 871 1314.4 871 C 1313.4 871 1313 869.6 1313 866.2 C 1313 852.7 1309.5 827.7 1305.6 812.7 C 1301.1 795.6 1291.8 776.1 1282.3 764 C 1272.1 751.1 1248.9 732.4 1237.2 727.7 C 1214.7 718.6 1204 716.7 1177.5 716.7 C 1156.1 716.7 1152.7 717.2 1129.5 722.4 C 1121.1 724.3 1105.4 729.7 1100 732.6 C 1097.5 733.9 1090.3 737.5 1084 740.6 C 1036.3 764 997.5 797 962.1 844.2 C 955.2 853.3 940.3 876.2 937.3 882.3 C 935.8 885.3 934.4 886.8 933.9 886.3 C 932.9 885.3 932.6 638.5 933.6 636.9 C 933.9 636.4 1041.2 636 1187.1 636 C 1408.3 636 1442.4 636.2 1458.3 637.6 C 1481.5 639.6 1491.7 641.2 1506 645 C 1510.1 646.2 1515.1 647.4 1517 647.9 C 1523.5 649.3 1550.5 659.8 1557.4 663.5 C 1559.6 664.8 1564 667.2 1567.1 668.8 C 1581.4 676.6 1599 689.3 1611.7 701.2 C 1614.5 703.8 1617.4 706 1617.9 706 C 1619.5 706 1619.4 619.8 1617.8 618.2 C 1616 616.4 617.9 616.5 616.2 618.2 Z';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = v => Math.min(1, Math.max(0, v));
  const sine = t => (1 - Math.cos(Math.PI * clamp(t))) / 2;
  const pointer = {x: 0, y: 0};
  addEventListener('pointermove', e => { pointer.x = e.clientX / innerWidth - .5; pointer.y = e.clientY / innerHeight - .5; }, {passive: true});

  // ---------- background film: tall file on upright screens, wide file otherwise; the stitch line sits on the centre line ----------
  // The opening's film, plus the copies other sections ask for (the product grid shows it under a white wash).
  function film(root){
    const portrait = matchMedia('(max-aspect-ratio: 1/1)');
    const vids = [];
    // the film plays like the original site (also with "reduce motion"); if a phone blocks autoplay
    // (iPhone Low Power Mode, data saver), it starts on the first touch, scroll or key
    const KICK = ['pointerdown', 'touchstart', 'scroll', 'keydown'];
    let armed = false;
    const kick = () => { KICK.forEach(t => removeEventListener(t, kick)); armed = false; vids.forEach(play); };
    function play(o){
      if (!o.visible || !o.v.src || document.hidden) return;
      const p = o.v.play();
      if (p) p.catch(() => { if (!armed) { armed = true; KICK.forEach(t => addEventListener(t, kick, {passive: true})); } });
    }
    function align(){ // keep the stitch line on the screen's centre line (the line between the product columns)
      const ref = vids.find(o => o.v.videoWidth); if (!ref) return;
      const nx = parseFloat(portrait.matches ? root.dataset.nxTall : root.dataset.nxWide) || .5;
      const vw = ref.v.videoWidth, vh = ref.v.videoHeight, W = document.documentElement.clientWidth, H = innerHeight;
      const shownW = vw * Math.max(W / vw, H / vh), slack = shownW - W;
      const p = slack > 1 ? clamp((nx * shownW - W / 2) / slack) : .5;
      const off = (W - shownW) * p + nx * shownW - W / 2;
      let tf = '';
      if (Math.abs(off) > .5 && Math.abs(off) < W / 2) { const s = 1 / (1 - Math.abs(off) / (W / 2)); tf = `translateX(${(-off * s).toFixed(1)}px) scale(${s.toFixed(4)})`; }
      vids.forEach(o => { o.v.style.objectPosition = (p * 100).toFixed(2) + '% 50%'; o.v.style.transform = tf; });
    }
    function setSrc(o){
      const k = portrait.matches ? 'tall' : 'wide';
      const src = root.dataset[k] || root.dataset.wide;
      if (!src) { o.v.hidden = true; return; }
      if (o.v.dataset.k === k) return;
      o.v.dataset.k = k;
      const poster = root.dataset[k + 'Poster']; if (poster && o.main) o.v.poster = poster;
      o.v.src = src;
      play(o);
    }
    function add(v, el, main){
      if (v.dataset.tmFilm) return; v.dataset.tmFilm = '1';
      v.muted = true; v.defaultMuted = true; v.playsInline = true; // phones only autoplay a muted, inline film
      const o = {v, main, visible: true};
      vids.push(o);
      v.addEventListener('loadedmetadata', align);
      v.addEventListener('canplay', () => { if (v.paused) play(o); });
      o.io = new IntersectionObserver(([e]) => { o.visible = e.isIntersecting; o.visible ? play(o) : v.pause(); });
      o.io.observe(el);
      setSrc(o); align();
    }
    add(root.querySelector('.tmo-film'), root, true);
    const mirror = v => add(v, v.closest('[data-tmg]') || v.parentElement, false);
    (window.TMFilmMirrors || []).forEach(mirror);
    const onMirror = e => mirror(e.detail);
    document.addEventListener('tm:film-mirror', onMirror);
    const pick = () => { vids.forEach(setSrc); align(); };
    portrait.addEventListener('change', pick);
    addEventListener('resize', align);
    const onVis = () => { if (!document.hidden) vids.forEach(play); };
    document.addEventListener('visibilitychange', onVis);

    // as the opening scrolls away the dark shade lifts and the white wash comes in (same as the original site)
    const shade = root.querySelector('.tmo-shade'), veil = root.querySelector('.tmo-veil');
    const veilMax = parseFloat(getComputedStyle(veil).getPropertyValue('--tmo-veil')) || 0;
    const fade = () => {
      const r = root.getBoundingClientRect(), t = clamp(-r.top / (r.height * .7));
      veil.style.opacity = (veilMax * t).toFixed(3);
      shade.style.opacity = (1 - t).toFixed(3);
      document.documentElement.classList.toggle('tm-on-film', r.bottom > 0 && t < .5);
    };
    addEventListener('scroll', fade, {passive: true}); fade();
    return () => {
      vids.forEach(o => { o.io.disconnect(); o.v.pause(); });
      document.removeEventListener('tm:film-mirror', onMirror); document.removeEventListener('visibilitychange', onVis);
      portrait.removeEventListener('change', pick); removeEventListener('resize', align); removeEventListener('scroll', fade);
      KICK.forEach(t => removeEventListener(t, kick));
    };
  }

  // ---------- the monogram ----------
  async function logo(root, clock){
    const cv = root.querySelector('.tmo-canvas'), slot = root.querySelector('.tmo-slot'), word = root.querySelector('.tmo-word');
    let THREE, RoomEnvironment, SVGLoader;
    try { [THREE, {RoomEnvironment}, {SVGLoader}] = await Promise.all([import(THREE_URL), import(ROOM_URL), import(SVG_URL)]); }
    catch (e) { return null; }
    let R;
    try { R = new THREE.WebGLRenderer({canvas: cv, antialias: true, alpha: true}); } catch (e) { return null; }
    R.setPixelRatio(Math.min(devicePixelRatio, 2));
    R.toneMapping = THREE.ACESFilmicToneMapping; R.outputColorSpace = THREE.SRGBColorSpace;
    const scene = new THREE.Scene();
    scene.environment = new THREE.PMREMGenerator(R).fromScene(new RoomEnvironment(), .04).texture;
    scene.environmentIntensity = .6;
    const cam = new THREE.PerspectiveCamera(32, 1, .1, 60); cam.position.set(0, 0, 9);
    const key = new THREE.DirectionalLight('#ffffff', 2.2); key.position.set(3, 4, 5); scene.add(key);
    const sweep = new THREE.PointLight('#fff4e0', 30, 14); sweep.position.set(1.8, 1.6, 4); scene.add(sweep);
    scene.add(new THREE.AmbientLight('#ffffff', .2));
    const shapes = SVGLoader.createShapes(new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${TM}"/></svg>`).paths[0]);
    const geo = new THREE.ExtrudeGeometry(shapes, {depth: 70, bevelEnabled: true, bevelThickness: 12, bevelSize: 6, bevelSegments: 12, curveSegments: 64});
    geo.center(); geo.rotateX(Math.PI);
    const mats = [
      new THREE.MeshPhysicalMaterial({color: '#0c0c0e', metalness: .2, roughness: .08, clearcoat: 1, clearcoatRoughness: .04, envMapIntensity: 1.6, transparent: true, opacity: 0}),
      new THREE.MeshPhysicalMaterial({color: '#d4af6a', metalness: 1, roughness: .22, envMapIntensity: 2.4, transparent: true, opacity: 0})
    ];
    const mesh = new THREE.Mesh(geo, mats); scene.add(mesh);
    const fit = {s: .002, y: 0}, eased = {x: 0, y: 0};
    function size(){
      const w = root.clientWidth, h = root.clientHeight;
      R.setSize(w, h, false); cam.aspect = w / h; cam.fov = w / h < .7 ? 40 : 32; cam.updateProjectionMatrix();
      const s = slot.getBoundingClientRect(), box = root.getBoundingClientRect();
      const wpp = 2 * Math.tan(THREE.MathUtils.degToRad(cam.fov / 2)) * 9 / h;
      fit.s = s.width * wpp / 1180;
      fit.y = -((s.top - box.top + s.height / 2) - h / 2) * wpp;
    }
    let running = false, raf = 0;
    function frame(t){
      if (running) raf = requestAnimationFrame(frame);
      const time = t / 1000, {intro, idle} = clock(t);
      eased.x += (pointer.x - eased.x) * .05; eased.y += (pointer.y - eased.y) * .05;
      const r = root.getBoundingClientRect(), away = clamp(-r.top / (r.height * .55));
      const o = intro * (1 - away);
      mats.forEach(m => { m.opacity = o; });
      mesh.visible = o > .01;
      if (!reduced) { sweep.position.x = Math.sin(time * .9) * 4.5; sweep.position.y = 1.4; }
      mesh.scale.setScalar(fit.s);
      mesh.position.y = fit.y + Math.sin(time * .6) * .035 * idle + away * .6;
      mesh.rotation.y = idle * (Math.sin(time * .35) * .22 + eased.x * .3);
      mesh.rotation.x = idle * eased.y * .12;
      word.style.opacity = 1 - away;
      R.render(scene, cam);
    }
    const onResize = () => { size(); if (!running) frame(performance.now()); };
    addEventListener('resize', onResize);
    if (document.fonts) document.fonts.ready.then(onResize);
    size();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !running) { running = true; raf = requestAnimationFrame(frame); }
      else if (!e.isIntersecting) { running = false; cancelAnimationFrame(raf); }
    });
    io.observe(root);
    if (reduced) addEventListener('scroll', () => frame(performance.now()), {passive: true});
    return () => { running = false; cancelAnimationFrame(raf); io.disconnect(); removeEventListener('resize', onResize); R.dispose(); };
  }

  function init(root){
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const stops = [film(root)];
    const caret = root.querySelector('.tmo-caret'), cue = root.querySelector('.tmo-cue'), letters = root.querySelectorAll('.tmo-word span');
    cue?.addEventListener('click', () => {
      const next = (root.closest('.shopify-section') || root).nextElementSibling;
      (next || document.body).scrollIntoView({behavior: reduced ? 'auto' : 'smooth'});
    });

    // timeline: type the word, then the monogram fades in, then it keeps fading out and back in
    let introAt = Infinity;
    const clock = t => {
      if (reduced) return {intro: 1, idle: 1};
      const e = (t - introAt) / 1000;
      if (e < 0) return {intro: 0, idle: 0};
      const idle = sine((e - 1) / 3);
      if (e < 1.8) return {intro: sine(e / 1.8), idle};
      const b = e - 1.8;
      if (b < 2.4) return {intro: 1, idle};
      const c = (b - 2.4) % 7.1;
      const intro = c < 1.8 ? 1 - sine(c / 1.8) : c < 2.7 ? 0 : c < 4.5 ? sine((c - 2.7) / 1.8) : 1;
      return {intro, idle};
    };
    const start = () => {
      root.classList.add('typed');
      if (reduced) { caret?.remove(); cue?.classList.add('on'); introAt = 0; return; }
      const typed = 300 + letters.length * 110 + 500;
      setTimeout(() => { caret?.classList.add('gone'); setTimeout(() => caret?.remove(), 300); }, typed + 200);
      introAt = performance.now() + typed + 600;
      setTimeout(() => cue?.classList.add('on'), typed + 1400);
    };
    const go = new IntersectionObserver(([e]) => { if (!e.isIntersecting) return; go.disconnect(); (document.fonts ? document.fonts.ready : Promise.resolve()).then(start); });
    go.observe(root);
    stops.push(() => go.disconnect());
    if (root.dataset.logo !== 'false') logo(root, clock).then(stop => stop && stops.push(stop));
    root._tmoStop = () => stops.forEach(s => s());
  }

  window.TMOpening = {init};
  document.querySelectorAll('[data-tmo]').forEach(init);
  document.addEventListener('shopify:section:load', e => e.target.querySelectorAll('[data-tmo]').forEach(init));
  document.addEventListener('shopify:section:unload', e => e.target.querySelectorAll('[data-tmo]').forEach(r => r._tmoStop?.()));
}
</script>

{% schema %}
{
  "name": "TM Opening",
  "tag": "section",
  "class": "tm-opening-section",
  "settings": [
    { "type": "text", "id": "word", "label": "Word", "default": "TAILORMADE" },
    {
      "type": "select", "id": "heading_tag", "label": "Heading tag", "default": "h2",
      "info": "Use h1 only if no other h1 is on the home page.",
      "options": [ { "value": "h1", "label": "h1" }, { "value": "h2", "label": "h2" }, { "value": "p", "label": "Paragraph" } ]
    },
    { "type": "checkbox", "id": "show_logo", "label": "Show the 3D TM monogram", "default": true },
    { "type": "checkbox", "id": "show_cue", "label": "Show the Scroll cue", "default": true },
    { "type": "header", "content": "Background film" },
    { "type": "video", "id": "video_wide", "label": "Film for wide screens (computer, tablet sideways)", "info": "bg-wide.mp4" },
    { "type": "video", "id": "video_tall", "label": "Film for tall screens (phone)", "info": "bg-tall.mp4" },
    { "type": "text", "id": "video_wide_url", "label": "Or a direct .mp4 link for wide screens", "info": "Settings > Files > copy link. Only used if no film is picked above." },
    { "type": "text", "id": "video_tall_url", "label": "Or a direct .mp4 link for tall screens" },
